{
  "id": 777,
  "name": "应用广告拦截",
  "version": 3,
  "author": "webcatx",
  "checkUpdateUrl": "./GKD-subscription.json3",
  "supportUri": "https://github.com/webcstx/doubao-quick-tools",
  "categories": [
    { "key": 0, "name": "开屏广告", "enable": true },
    { "key": 6, "name": "局部广告", "enable": true },
    { "key": 7, "name": "全屏广告", "enable": true }
  ],
  "globalGroups": [
    {
      "key": 0,
      "name": "开屏广告",
      "desc": "自动跳过开屏广告",
      "fastQuery": true,
      "matchTime": 10000,
      "actionMaximum": 1,
      "resetMatch": "app",
      "rules": [
        {
          "key": 0,
          "matches": "[text*=\"跳过\"][text.length<10][width<500 && height<300][visibleToUser=true]"
        }
      ]
    },
    {
      "key": 6,
      "name": "局部广告",
      "desc": "关闭局部广告",
      "fastQuery": true,
      "matchTime": 5000,
      "actionMaximum": 1,
      "resetMatch": "app",
      "rules": [
        {
          "key": 0,
          "matches": "[text*=\"广告\"][text*=\"关闭\"][clickable=true][visibleToUser=true]"
        }
      ]
    },
    {
      "key": 7,
      "name": "全屏广告",
      "desc": "关闭全屏广告",
      "fastQuery": true,
      "matchTime": 8000,
      "actionMaximum": 1,
      "resetMatch": "app",
      "rules": [
        {
          "key": 0,
          "matches": "[text*=\"立即关闭\"][clickable=true][visibleToUser=true]"
        }
      ]
    }
  ],
  "apps": []
}

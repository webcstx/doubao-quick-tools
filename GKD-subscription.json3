{
  "id": 777,
  "name": "应用广告拦截",
  "version": 3,
  "author": "webcatx",
  "checkUpdateUrl": "./GKD-subscription.json3",
  "supportUri": "https://github.com/webcstx/doubao-quick-tools",
  "categories": [
    { "key": 0, "name": "开屏广告", "enable": true },
    { "key": 1, "name": "青少年模式", "enable": false },
    { "key": 2, "name": "更新提示", "enable": false },
    { "key": 3, "name": "评价提示", "enable": false },
    { "key": 4, "name": "通知提示", "enable": false },
    { "key": 5, "name": "权限提示", "enable": false },
    { "key": 6, "name": "局部广告", "enable": true },
    { "key": 7, "name": "全屏广告", "enable": true },
    { "key": 8, "name": "分段广告", "enable": false },
    { "key": 9, "name": "功能类", "enable": false },
    { "key": 10, "name": "其他", "enable": false }
  ],
  "globalGroups": [
    {
      "key": 0,
      "name": "开屏广告",
      "desc": "自动跳过开屏广告",
      "fastQuery": true,
      "matchTime": 10000,
      "actionMaximum": 1,
      "resetMatch": "app",
      "rules": [
        {
          "key": 0,
          "matches": "[text*=\"跳过\"][text.length<10][width<500 && height<300][visibleToUser=true]"
        }
      ]
    },
    {
      "key": 1,
      "name": "青少年模式",
      "desc": "关闭青少年模式弹窗（默认关闭）",
      "fastQuery": true,
      "matchTime": 5000,
      "actionMaximum": 1,
      "resetMatch": "app",
      "enable": false,
      "rules": [
        {
          "key": 0,
          "matches": "[text*=\"青少年模式\"][text*=\"关闭\"][clickable=true][visibleToUser=true]"
        }
      ]
    },
    {
      "key": 2,
      "name": "更新提示",
      "desc": "关闭应用更新弹窗（默认关闭）",
      "fastQuery": true,
      "matchTime": 5000,
      "actionMaximum": 1,
      "resetMatch": "app",
      "enable": false,
      "rules": [
        {
          "key": 0,
          "matches": "[text*=\"更新\"][text*=\"取消\"][clickable=true][visibleToUser=true]"
        }
      ]
    },
    {
      "key": 6,
      "name": "局部广告",
      "desc": "关闭局部广告",
      "fastQuery": true,
      "matchTime": 5000,
      "actionMaximum": 1,
      "resetMatch": "app",
      "rules": [
        {
          "key": 0,
          "matches": "[text*=\"广告\"][text*=\"关闭\"][clickable=true][visibleToUser=true]"
        }
      ]
    },
    {
      "key": 7,
      "name": "全屏广告",
      "desc": "关闭全屏广告",
      "fastQuery": true,
      "matchTime": 8000,
      "actionMaximum": 1,
      "resetMatch": "app",
      "rules": [
        {
          "key": 0,
          "matches": "[text*=\"立即关闭\"][clickable=true][visibleToUser=true]"
        }
      ]
    }
  ],
  "apps": []
}

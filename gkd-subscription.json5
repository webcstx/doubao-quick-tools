{
  "id": 777,
  "name": "应用广告拦截",
  "version": 12,
  "author": "webcatx",
  "checkUpdateUrl": "./gkd-subscription.json5",
  "supportUri": "https://github.com/webcstx/doubao-quick-tools",
  "categories": [
    { "key": 0, "name": "开屏广告", "enable": true },
    { "key": 1, "name": "青少年模式", "enable": false },
    { "key": 2, "name": "更新提示", "enable": false },
    { "key": 3, "name": "评价提示", "enable": false },
    { "key": 4, "name": "通知提示", "enable": false },
    { "key": 5, "name": "权限提示", "enable": false },
    { "key": 6, "name": "局部广告", "enable": true },
    { "key": 7, "name": "全屏广告", "enable": true },
    { "key": 8, "name": "分段广告", "enable": false },
    { "key": 9, "name": "功能类", "enable": false },
    { "key": 10, "name": "其他", "enable": false }
  ],
  "globalGroups": [
    {
      "key": 0,
      "name": "开屏广告-全局",
      "desc": "毫秒级自动跳过开屏广告",
      "order": -100,
      "fastQuery": true,
      "matchTime": 10000,
      "actionMaximum": 2,
      "resetMatch": "app",
      "priorityTime": 100,
      "forcedTime": 1000,
      "rules": [
        {
          "anyMatches": [
            "[text*=\"跳过\"][text.length<10][width<500 && height<300][visibleToUser=true]",
            "[desc*=\"跳过\"][desc.length<10][visibleToUser=true]",
            "[id$=\"tt_splash_skip_btn\"][visibleToUser=true]"
          ]
        }
      ]
    },
    {
      "key": 6,
      "name": "局部广告-全局",
      "desc": "毫秒级关闭局部广告",
      "order": -50,
      "fastQuery": true,
      "matchTime": 5000,
      "actionMaximum": 1,
      "resetMatch": "app",
      "priorityTime": 100,
      "rules": [
        {
          "matches": [
            "[text*=\"广告\"][text*=\"关闭\"][clickable=true][visibleToUser=true]",
            "[desc*=\"广告\"][desc*=\"关闭\"][clickable=true][visibleToUser=true]"
          ]
        }
      ]
    },
    {
      "key": 7,
      "name": "全屏广告-全局",
      "desc": "毫秒级关闭全屏广告",
      "order": -90,
      "fastQuery": true,
      "matchTime": 8000,
      "actionMaximum": 1,
      "resetMatch": "app",
      "priorityTime": 100,
      "rules": [
        {
          "matches": [
            "[text*=\"立即关闭\"][clickable=true][visibleToUser=true]",
            "[text*=\"点击关闭\"][clickable=true][visibleToUser=true]"
          ]
        }
      ]
    }
  ],
  "apps": []
}

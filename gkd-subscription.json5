{
  "id": 8888,
  "name": "猫爪跳过",
  "version": 2,
  "author": "webcatx",
  "checkUpdateUrl": "https://raw.githubusercontent.com/webcstx/doubao-quick-tools/main/gkd-subscription.json5",
  "supportUri": "https://github.com/webcstx/doubao-quick-tools",
  "categories": [
    { "key": 1, "name": "开屏秒跳", "enable": true },
    { "key": 2, "name": "局部广告", "enable": true }
  ],
  "globalGroups": [
    {
      "key": 101,
      "name": "开屏自动点",
      "desc": "看到跳过就点",
      "order": -100,
      "fastQuery": true,
      "matchTime": 8000,
      "actionMaximum": 1,
      "resetMatch": "app",
      "rules": [
        {
          "key": 0,
          "matches": [
            "[text^=\"跳过\"][text.length<8][clickable=true][visibleToUser=true]",
            "[desc^=\"跳过\"][desc.length<8][clickable=true][visibleToUser=true]",
            "[id$=\"_skip_btn\"][clickable=true][visibleToUser=true]"
          ]
        }
      ]
    },
    {
      "key": 202,
      "name": "局部关广告",
      "desc": "关掉小广告",
      "order": -50,
      "fastQuery": true,
      "matchTime": 5000,
      "actionMaximum": 1,
      "resetMatch": "app",
      "rules": [
        {
          "key": 0,
          "matches": [
            "[text*=\"关闭广告\"][clickable=true][visibleToUser=true]",
            "[desc*=\"关闭广告\"][clickable=true][visibleToUser=true]",
            "[id*=\"close_ad\"][clickable=true][visibleToUser=true]"
          ]
        }
      ]
    }
  ],
  "apps": []
}

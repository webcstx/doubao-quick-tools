{
  "manifest_version": 3,
  "name": "极速广告拦截器",
  "version": "2.0.0",
  "description": "自动拦截网页弹窗广告、悬浮广告、横幅广告",
  "permissions": ["scripting", "activeTab", "storage"],
  "host_permissions": ["<all_urls>"],
  "action": { "default_popup": "popup.html" },
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["content.js"],
    "run_at": "document_start"
  }]
}
